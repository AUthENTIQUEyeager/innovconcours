# --- Supabase ---
# Depuis Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Clé service_role — JAMAIS exposée au client, utilisée uniquement dans les routes API serveur
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- FusionPay (Money Fusion) ---
# Depuis moneyfusion.net/dashboard/pay > "API de paiement" > Créer une application
# ATTENTION : l'IP sortante du serveur qui appelle cette URL doit être enregistrée
# dans le dashboard FusionPay (voir README, section "Point d'attention IP").
FUSIONPAY_API_URL=https://www.pay.moneyfusion.net/VOTRE_APPLICATION/pay/

# URL publique du site (utilisée pour construire return_url et webhook_url)
NEXT_PUBLIC_SITE_URL=https://innovconcours.com
